# Copia a .env.local para overrides locales. Los valores de Sanity (públicos) ya tienen
# default en src/lib/sanity.js, así que el repo funciona recién clonado sin tocar nada.

# URL pública del sitio (canonicals, OG, sitemap). Sin barra final.
VITE_SITE_URL=https://contalfa.com

# Origen del API en producción (p.ej. https://contalfa-api.onrender.com). Sin barra final.
# Vacío en dev: el proxy de Vite redirige /api a localhost:3001.
VITE_API_URL=

# Sanity (público, NO secreto). Override opcional de los defaults de src/lib/sanity.js:
VITE_SANITY_PROJECT_ID=hbsenmzc
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Overlay de Sanity en vivo. Va en .env.development (solo dev), NUNCA en producción.
# VITE_USE_SANITY=true
